# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/nexahr

# JWT signing secret
JWT_SECRET=change-me

# Server
PORT=5000
NODE_ENV=development

# Frontend base URL used to build the password reset link (HashRouter)
CLIENT_URL=http://localhost:8080

# Resend email (https://resend.com) — required to actually deliver reset emails.
# When unset, the reset link is logged to the server console instead of emailed.
RESEND_API_KEY=
RESEND_FROM=NexaHR <onboarding@resend.dev>
